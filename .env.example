# VAJRA Blockchain Forensics Suite - Configuration

# 1. On-Chain Data Provider Keys
# Ethereum API Key (Etherscan v2)
VITE_ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Trongrid API Key (for Tron transactions)
VITE_TRONGRID_API_KEY=YOUR_TRONGRID_API_KEY

# Covalent GoldRush API Key (Multi-chain backup API)
VITE_GOLDRUSH_API_KEY=YOUR_GOLDRUSH_API_KEY

# 2. AI & LLM Provider Keys
# OpenRouter API Key (Supports DeepSeek R1, Qwen, Kimi models)
VITE_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# 3. Machine Learning Microservice Configuration
# GNN exchange classifier service URL
VITE_ML_SERVICE_URL=http://localhost:8000
